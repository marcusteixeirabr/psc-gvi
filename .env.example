# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pscgvi
DB_USER=pscgvi
DB_PASSWORD=troque_aqui

# Sessão
SESSION_SECRET=gere_uma_string_aleatoria_longa

# ZP-21 — URL da página de movimentação (pode mudar sem aviso, alterar aqui)
ZP21_URL=https://praticoszp21.com.br/movimentacao-de-navios/

# VesselFinder — busca de IMO por nome (pode mudar sem aviso, alterar aqui)
VESSEL_FINDER_URL=https://www.vesselfinder.com

# CIALA (Acordo Latino-Americano / Viña del Mar)
CIALA_URL=https://ciala.acuerdolatinoamericano.org
CIALA_USERNAME=seu_usuario
CIALA_PASSWORD=sua_senha

# Alertas por e-mail (opcional — deixe em branco para desativar)
# Gmail: use App Password (não a senha normal) em smtp.gmail.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_app_password
ALERT_EMAIL=marcusteixeirabr@gmail.com

# Servidor
PORT=8080
ENV=development
